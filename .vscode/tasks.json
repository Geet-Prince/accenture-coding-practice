{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Accenture: Run Current Question",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run-test.ps1",
                "${file}"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Accenture: Run Visible Tests",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run-test.ps1",
                "${file}",
                "-Visible"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Accenture: Run All Tests",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run-test.ps1",
                "${file}",
                "-All"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Accenture: Compile Current Question",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/compile.ps1",
                "${file}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Accenture: Run All Repository Tests",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run-all-tests.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Accenture: Run Topic Tests",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run-all-tests.ps1",
                "-Topic", "${input:topicFolder}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "topicFolder",
            "description": "Select a topic folder",
            "type": "pickString",
            "options": [
                "01-Arrays",
                "02-Strings",
                "03-Math-Numbers",
                "04-Hashing-Frequency",
                "05-Pseudocode-Bitwise",
                "06-Linked-List",
                "07-Stack-Queue",
                "08-Recursion",
                "09-Greedy",
                "10-Trees",
                "11-Graphs",
                "12-Dynamic-Programming",
                "13-Mixed-Accenture",
                "14-Mock-Tests"
            ]
        }
    ]
}
