{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Accenture: Run Current Question",
            "type": "process",
            "windows": {
                "command": "powershell"
            },
            "linux": {
                "command": "pwsh"
            },
            "osx": {
                "command": "pwsh"
            },
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run-test.ps1",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
